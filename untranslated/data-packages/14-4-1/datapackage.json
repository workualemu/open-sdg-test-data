{
  "resources": [
    {
      "path": "data.csv",
      "name": "data",
      "profile": "tabular-data-resource",
      "scheme": "file",
      "format": "csv",
      "hashing": "md5",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "Year",
            "type": "integer"
          },
          {
            "name": "OBS_STATUS",
            "type": "string",
            "constraints": {
              "enum": [
                "O",
                "A",
                ""
              ]
            }
          },
          {
            "name": "NATURE",
            "type": "string",
            "constraints": {
              "enum": [
                "_X",
                "C",
                ""
              ]
            }
          },
          {
            "name": "COMMENT_OBS",
            "type": "string",
            "constraints": {
              "enum": [
                "NaN = A figure was not provided",
                "The indicator reported here is based on FAO SDG 14.4.1 questionnaire Field 222: Overfished (yes o). here using 8 stocks where 12.5% had an unknown stock status.",
                "Obs_Value = NaN means no data was provided by the country",
                ""
              ]
            }
          },
          {
            "name": "SOURCE_DETAIL",
            "type": "string",
            "constraints": {
              "enum": [
                "NA",
                "FAO SDG14.4.1 questionnaire. Values were produced according to the SDG14.4.1 Metadata document.",
                ""
              ]
            }
          },
          {
            "name": "Value",
            "type": "string"
          }
        ]
      }
    }
  ],
  "profile": "data-package",
  "name": "14-4-1",
  "title": "Proportion of fish stocks within biologically sustainable levels"
}